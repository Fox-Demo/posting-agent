# Meta (Facebook/Instagram) API Configuration
META_APP_ID=
META_APP_SECRET=
META_PAGE_ID=
META_INSTAGRAM_ACCOUNT_ID=
META_API_VERSION=v20.0

# Required to publish. Get it with:
#   python3 scripts/fb_get_page_token.py <SHORT_LIVED_USER_TOKEN>
META_PAGE_ACCESS_TOKEN=


# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key
OPENAI_TEXT_MODEL=gpt-4
OPENAI_IMAGE_MODEL=dall-e-3
OPENAI_IMAGE_SIZE=1024x1024
OPENAI_IMAGE_QUALITY=standard

# Cloudinary Configuration (for image hosting)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_UPLOAD_FOLDER=auto_posting

# Application Settings
DEBUG=false
LOG_LEVEL=INFO
TOKEN_FILE=tokens.enc
ENCRYPTION_KEY=  # Auto-generated if not set
