# Meta (Facebook/Instagram) API Configuration
META_APP_ID=your_app_id
META_APP_SECRET=your_app_secret
META_PAGE_ID=your_page_id
META_INSTAGRAM_ACCOUNT_ID=your_instagram_business_account_id
META_ACCESS_TOKEN=  # Will be set after OAuth setup
META_API_VERSION=v20.0

# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key
OPENAI_TEXT_MODEL=gpt-4
OPENAI_IMAGE_MODEL=dall-e-3
OPENAI_IMAGE_SIZE=1024x1024
OPENAI_IMAGE_QUALITY=standard

# Cloudinary Configuration (for image hosting)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_UPLOAD_FOLDER=auto_posting

# Application Settings
DEBUG=false
LOG_LEVEL=INFO
TOKEN_FILE=tokens.enc
ENCRYPTION_KEY=  # Auto-generated if not set
